# Azure OpenAI / Microsoft Foundry OpenAI-compatible v1 endpoint.
# Must end with /openai/v1/
AZURE_OPENAI_BASE_URL=https://<your-resource>.openai.azure.com/openai/v1/

# API key for the resource above. Keep it out of git; in Azure use a secret.
AZURE_OPENAI_API_KEY=

# The *deployment* name, not the base model name.
AZURE_OPENAI_MODEL=security-agent

# Slack app credentials. Required only for the /slack/events endpoint.
# Basic Information -> App Credentials -> Signing Secret
SLACK_SIGNING_SECRET=

# OAuth & Permissions -> Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN=

# Log Analytics workspace GUID (customerId) holding your application events.
# Access uses Managed Identity in Azure and `az login` locally - no secret here.
# Leave blank to run without investigation tools.
AZURE_LOG_ANALYTICS_WORKSPACE_ID=

# --- Telemetry schema -------------------------------------------------------
# Which table and field names hold your application's security events. Defaults
# assume Application Insights `AppEvents` with detail in a `Properties` JSON
# column. Override to match your own instrumentation.
TELEMETRY_TABLE=AppEvents
TELEMETRY_PROPERTIES=Properties
TELEMETRY_FIELD_USER=userId
TELEMETRY_FIELD_EMAIL=email
TELEMETRY_FIELD_IP=ipAddress
TELEMETRY_FIELD_PATH=path
TELEMETRY_FIELD_METHOD=method
TELEMETRY_FIELD_SEVERITY=severity
TELEMETRY_FIELD_USER_AGENT=userAgent

# User agents indicating a server-side (edge/serverless) caller rather than an
# end user, so a rotating platform egress IP is not read as distinct clients.
PLATFORM_USER_AGENTS=Edge Functions,Lambda,node-fetch,axios,undici
